---
import Icon from "./ui/Icon.astro";

const links = [
  { href: "/#about", label: "About" },
  { href: "/#projects", label: "Projects" },
  { href: "/#contact", label: "Contact" },
];
---

<nav
  class="fixed inset-x-0 top-0 z-50 border-b border-subtle bg-background/70 backdrop-blur-xl"
  aria-label="Main"
>
  <div
    class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between"
  >
    <a href="/#home" class="text-sm font-semibold tracking-tight text-primary">
      {"<d.R />"}
    </a>
    <div class="flex items-center gap-2">
      <ul class="hidden items-center gap-1 sm:flex">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                class="rounded-full px-4 py-2 text-sm font-medium text-secondary transition duration-200 hover:bg-white/5 hover:text-primary"
                href={href}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/#contact"
        class="hidden rounded-full border bg-surface-elevated/60 px-4 py-1.5 text-sm font-medium text-primary shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] transition duration-200 hover:border-strong hover:bg-surface-elevated sm:inline-flex"
      >
        Get in touch
      </a>
      <details id="mobile-menu" class="relative sm:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full border bg-surface-elevated/60 text-secondary transition hover:text-primary [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">Menu</span>
          <Icon name="menu" />
        </summary>
        <ul
          class="absolute right-0 top-12 w-48 rounded-lg border bg-surface-elevated p-1.5 shadow-elevated"
        >
          {
            links.map(({ href, label }) => (
              <li>
                <a
                  class="block rounded-md px-4 py-2 text-sm font-medium text-secondary transition hover:bg-white/5 hover:text-primary"
                  href={href}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </div>
</nav>

<script>
  // Close the mobile menu when a link is picked.
  const menu = document.getElementById("mobile-menu");
  menu
    ?.querySelectorAll("a")
    .forEach((a) =>
      a.addEventListener("click", () => menu.removeAttribute("open")),
    );
</script>
