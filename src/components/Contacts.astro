---
import Dither from "./Dither.astro";
import Button from "./ui/Button.astro";
import Container from "./ui/Container.astro";
import Heading from "./ui/Heading.astro";
import Text from "./ui/Text.astro";

const field =
  "w-full rounded-field border bg-white/[0.03] px-4 py-3.5 text-primary placeholder:text-muted transition duration-200 focus:border-accent/60 focus:outline-none focus:ring-2 focus:ring-accent/20";
---

<section id="contact" class="scroll-mt-28 border-t border-subtle bg-surface">
  <Container class="grid gap-14 pb-8 pt-24 sm:pt-32 md:grid-cols-2">
    <div data-reveal>
      <Heading as="h2" size="display">Let’s talk</Heading>
      <Text variant="lead" class="mt-4"
        >Ready to build something? Let’s get started.</Text
      >
      <Text as="span" variant="label" tone="muted" class="mt-14 block"
        >Get in touch</Text
      >
      <button
        id="copy-email"
        class="mt-3 inline-flex items-center gap-3 text-xl font-medium text-primary transition duration-200 hover:text-accent sm:text-2xl cursor-pointer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path
            d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
          ></path></svg
        >
        webdevrokas@gmail.com
      </button>
      <span
        id="copy-status"
        role="status"
        class="mt-2 block h-5 text-sm text-accent"></span>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button
          href="https://github.com/fraxxio/"
          target="_blank"
          rel="noopener noreferrer"
          variant="secondary"
          size="sm">GitHub ↗</Button
        >
        <Button
          href="https://www.linkedin.com/in/rokasleonavi%C4%8Dius/"
          target="_blank"
          rel="noopener noreferrer"
          variant="secondary"
          size="sm">LinkedIn ↗</Button
        >
        <Button href="/CV.pdf" download variant="secondary" size="sm"
          >CV ↓</Button
        >
      </div>
    </div>

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      id="form"
      class="flex flex-col gap-4"
      novalidate
      data-reveal
    >
      <input
        type="hidden"
        name="access_key"
        value={import.meta.env.ACCESS_KEY}
      />
      <input
        type="checkbox"
        class="hidden"
        style="display:none"
        name="botcheck"
      />
      <div>
        <label for="full_name" class="sr-only">Full name</label>
        <input
          id="full_name"
          type="text"
          placeholder="Full name"
          required
          name="name"
          class={field}
        />
      </div>
      <div>
        <label for="email_address" class="sr-only">Email address</label>
        <input
          id="email_address"
          type="email"
          placeholder="Email address"
          name="email"
          required
          class={field}
        />
      </div>
      <div>
        <label for="message" class="sr-only">Your message</label>
        <textarea
          id="message"
          name="message"
          required
          placeholder="Your message…"
          class:list={[field, "h-36 resize-none"]}></textarea>
      </div>
      <Button type="submit" class="w-full">Send message</Button>
      <div id="result" role="status" class="text-center text-sm"></div>
    </form>
  </Container>

  <div class="relative mt-12 h-52 sm:h-72" data-reveal>
    <Dither
      class="absolute inset-0 opacity-30"
      shape="wave"
      front="#00ffb3"
      back="#16241e"
      speed={0.25}
      pxSize={3}
    />
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-surface to-transparent"
      aria-hidden="true"
    >
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById("copy-email");
  const copyStatus = document.getElementById("copy-status") as HTMLElement;
  copyBtn?.addEventListener("click", async () => {
    await navigator.clipboard.writeText("webdevrokas@gmail.com");
    copyStatus.textContent = "Copied to clipboard ✓";
    setTimeout(() => (copyStatus.textContent = ""), 2000);
  });

  const form = document.getElementById("form") as HTMLFormElement | null;
  const result = document.getElementById("result") as HTMLElement;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.classList.add("was-validated");
      (form.querySelector(":invalid") as HTMLElement | null)?.focus();
      return;
    }
    const json = JSON.stringify(Object.fromEntries(new FormData(form)));
    result.textContent = "Sending...";
    result.classList.remove("text-green-500", "text-red-500");

    fetch("https://api.web3forms.com/submit", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json",
      },
      body: json,
    })
      .then(async (response) => {
        const data = await response.json();
        result.classList.add(
          response.status === 200 ? "text-green-500" : "text-red-500",
        );
        result.textContent = data.message;
      })
      .catch(() => {
        result.textContent = "Something went wrong!";
      })
      .then(() => {
        form.reset();
        form.classList.remove("was-validated");
        setTimeout(() => (result.textContent = ""), 5000);
      });
  });
</script>
