---
import Dither from "./Dither.astro";

// ponytail: footer is #141414 in both themes, matching the reference design.
const socialClass =
  "inline-flex items-center gap-1.5 rounded-full border-2 border-accent px-4 py-2 text-sm font-bold text-[#f4f4ef] transition hover:bg-accent hover:text-black";
---

<section id="contact" class="border-t-2 border-ink bg-[#141414] text-[#f4f4ef]">
  <div
    class="mx-auto grid max-w-6xl gap-14 px-4 pb-6 pt-20 sm:pt-28 md:grid-cols-2"
  >
    <div data-reveal>
      <h2 class="text-5xl font-bold sm:text-6xl">Let’s talk</h2>
      <p class="mt-4 text-lg opacity-75">
        Ready to build something? Let’s get started.
      </p>
      <p class="sec-tag mt-12 text-accent">Get in touch</p>
      <button
        id="copy-email"
        class="mt-2 inline-flex items-center gap-3 border-b-2 border-transparent pb-0.5 text-xl font-bold transition hover:border-accent sm:text-2xl"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path
            d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
          ></path></svg
        >
        webdevrokas@gmail.com
      </button>
      <span
        id="copy-status"
        role="status"
        class="mt-2 block h-5 text-sm text-accent"></span>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="https://github.com/fraxxio/"
          target="_blank"
          rel="noopener noreferrer"
          class={socialClass}>GitHub ↗</a
        >
        <a
          href="https://www.linkedin.com/in/rokasleonavi%C4%8Dius/"
          target="_blank"
          rel="noopener noreferrer"
          class={socialClass}>LinkedIn ↗</a
        >
        <a href="/CV.pdf" download class={socialClass}>CV ↓</a>
      </div>
    </div>

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      id="form"
      class="flex flex-col gap-4"
      novalidate
      data-reveal
    >
      <input
        type="hidden"
        name="access_key"
        value={import.meta.env.ACCESS_KEY}
      />
      <input
        type="checkbox"
        class="hidden"
        style="display:none"
        name="botcheck"
      />
      <div>
        <label for="full_name" class="sr-only">Full name</label>
        <input
          id="full_name"
          type="text"
          placeholder="Full name"
          required
          name="name"
          class="form-field"
        />
      </div>
      <div>
        <label for="email_address" class="sr-only">Email address</label>
        <input
          id="email_address"
          type="email"
          placeholder="Email address"
          name="email"
          required
          class="form-field"
        />
      </div>
      <div>
        <label for="message" class="sr-only">Your message</label>
        <textarea
          id="message"
          name="message"
          required
          placeholder="Your message…"
          class="form-field h-36"></textarea>
      </div>
      <button
        type="submit"
        class="rounded-xl border-2 border-accent bg-accent px-4 py-3.5 text-center font-bold text-black transition hover:-translate-y-0.5"
      >
        Send message ⇢
      </button>
      <div id="result" role="status" class="text-center"></div>
    </form>
  </div>

  <div class="relative h-52 sm:h-72" data-reveal>
    <Dither
      class="absolute inset-0"
      shape="wave"
      front="#f5c518"
      back="#141414"
      speed={0.25}
      pxSize={3}
    />
  </div>
</section>

<style>
  .form-field {
    width: 100%;
    border: 2px solid #3a3a3a;
    border-radius: 0.75rem;
    background: transparent;
    padding: 0.875rem 1rem;
    font-weight: 700;
    color: #f4f4ef;
    outline: none;
    transition: border-color 200ms ease;
  }
  .form-field::placeholder {
    color: #8a8a82;
    font-weight: 400;
  }
  .form-field:focus {
    border-color: #f5c518;
  }
</style>

<script>
  const copyBtn = document.getElementById("copy-email");
  const copyStatus = document.getElementById("copy-status") as HTMLElement;
  copyBtn?.addEventListener("click", async () => {
    await navigator.clipboard.writeText("webdevrokas@gmail.com");
    copyStatus.textContent = "Copied to clipboard ✓";
    setTimeout(() => (copyStatus.textContent = ""), 2000);
  });

  const form = document.getElementById("form") as HTMLFormElement | null;
  const result = document.getElementById("result") as HTMLElement;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.classList.add("was-validated");
      (form.querySelector(":invalid") as HTMLElement | null)?.focus();
      return;
    }
    const json = JSON.stringify(Object.fromEntries(new FormData(form)));
    result.textContent = "Sending...";
    result.classList.remove("text-green-500", "text-red-500");

    fetch("https://api.web3forms.com/submit", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json",
      },
      body: json,
    })
      .then(async (response) => {
        const data = await response.json();
        result.classList.add(
          response.status === 200 ? "text-green-500" : "text-red-500",
        );
        result.textContent = data.message;
      })
      .catch(() => {
        result.textContent = "Something went wrong!";
      })
      .then(() => {
        form.reset();
        form.classList.remove("was-validated");
        setTimeout(() => (result.textContent = ""), 5000);
      });
  });
</script>
