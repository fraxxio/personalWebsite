---
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";
import Card from "./ui/Card.astro";
import Container from "./ui/Container.astro";
import Heading from "./ui/Heading.astro";
import Section from "./ui/Section.astro";
import Text from "./ui/Text.astro";

const stack = [
  "React",
  "Next.js",
  "TypeScript",
  "Tailwind",
  "Node.js",
  "Express.js",
  "ASP.NET",
  "Zod",
  "Git",
];
---

<!-- Add interactions and animations -->
<Section id="about" surface>
  <Container>
    <div class="max-w-3xl" data-reveal>
      <Text as="span" variant="label" tone="muted">About me</Text>
      <Heading as="h2" class="mt-4">An engineer, not a frameworker</Heading>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-[1.5fr_1fr]">
      <Card class="flex flex-col md:row-span-2" data-reveal>
        <Text as="span" variant="label" tone="muted">Who am I?</Text>
        <p class="mt-5 text-xl leading-relaxed text-primary sm:text-2xl">
          A <span class="font-semibold">true engineer</span>, not a
          “frameworker” — languages and frameworks are just tools for solving
          problems. I create
          <span class="font-semibold">full-stack web applications</span>, mostly
          around the React ecosystem, with exposure to back-end stacks like
          ASP.NET and Express.js.
        </p>
        <div class="mt-7 flex flex-wrap gap-2">
          {stack.map((tech) => <Badge>{tech}</Badge>)}
        </div>
        <div class="mt-auto flex flex-wrap items-center gap-5 pt-10">
          <Button href="/about" variant="secondary">
            More about me
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </Button>
          <Button href="/CV.pdf" download variant="ghost">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
              ></path><polyline points="7 10 12 15 17 10"></polyline><line
                x1="12"
                x2="12"
                y1="15"
                y2="3"></line></svg
            >
            Download CV
          </Button>
        </div>
      </Card>

      <Card data-reveal>
        <div
          class="text-5xl font-semibold tracking-tight text-accent sm:text-6xl"
        >
          2–3 yrs
        </div>
        <Text class="mt-4">
          of hands-on experience building & shipping web applications
        </Text>
      </Card>

      <Card class="flex items-center gap-5" data-reveal>
        <div class="flex-none rounded-md border bg-white p-2">
          <img
            src="/VT.png"
            alt="Vilnius Tech university logo"
            class="h-12 w-auto"
            loading="lazy"
          />
        </div>
        <div>
          <p class="font-medium text-primary">BSc Software Engineering</p>
          <Text tone="muted" class="mt-1 text-sm leading-6">
            Scholarship for outstanding academic performance
          </Text>
        </div>
      </Card>
    </div>
  </Container>
</Section>
