---
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";
import Card from "./ui/Card.astro";
import Container from "./ui/Container.astro";
import Heading from "./ui/Heading.astro";
import Section from "./ui/Section.astro";
import Text from "./ui/Text.astro";

const stack = [
  "React",
  "Next.js",
  "TypeScript",
  "Tailwind",
  "Styled Components",
  "Node.js",
  "Express.js",
  "Bun",
  "WebSockets",
  "Docker",
  "Git",
];
---

<Section id="about" surface class="relative isolate">
  <div
    data-about-grid
    class="pointer-events-none absolute inset-0 -z-10 overflow-hidden bg-[linear-gradient(to_right,rgba(45,212,191,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(45,212,191,0.05)_1px,transparent_1px)] bg-size-[56px_56px] mask-[linear-gradient(to_bottom,transparent,black_15%,black_85%,transparent)]"
    aria-hidden="true"
  >
  </div>
  <Container>
    <div class="max-w-3xl" data-reveal>
      <Text as="span" variant="label" tone="muted">About me</Text>
      <Heading as="h2" class="mt-4">An engineer, not a frameworker</Heading>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-[1.5fr_1fr]">
      <Card class="glass-card flex flex-col md:row-span-2" data-reveal>
        <Text as="span" variant="label" tone="muted">Who am I?</Text>
        <p class="mt-5 text-xl leading-relaxed text-primary sm:text-2xl">
          I architect and lead the development of
          <span class="font-semibold">large-scale web applications</span>, owning technical
          decisions from design systems and real-time features to performance and SEO. Mostly in the
          <span class="font-semibold">React and TypeScript</span> ecosystem, but languages and frameworks
          are just tools. Solving the problem is the job.
        </p>
        <div class="mt-7 flex flex-wrap gap-2">
          {stack.map((tech) => <Badge>{tech}</Badge>)}
        </div>
        <div class="mt-auto flex flex-wrap items-center gap-5 pt-10">
          <Button href="/about" variant="secondary">
            More about me
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </Button>
          <Button href="/CV.pdf" download variant="ghost">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline
                points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"
              ></line></svg
            >
            Download CV
          </Button>
        </div>
      </Card>

      <Card class="glass-card" data-reveal>
        <div class="text-5xl font-semibold tracking-tight text-accent sm:text-6xl">4 yrs</div>
        <Text class="mt-4">
          of hands-on experience building & shipping high-performance web applications
        </Text>
