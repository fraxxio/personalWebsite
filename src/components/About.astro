---
const stack = ['React', 'Next.js', 'TypeScript', 'Tailwind', 'Node.js', 'Express.js', 'ASP.NET', 'Zod', 'Git'];
---

<section id='about' class='scroll-mt-24 px-4 py-16 sm:py-24'>
  <div class='mx-auto max-w-6xl'>
    <div class='mb-8 flex items-center gap-4' data-reveal>
      <h2 class='sec-tag text-ink'>✦ About me</h2>
      <div class='h-0.5 flex-1 bg-line'></div>
    </div>

    <div class='grid gap-5 md:grid-cols-[1.5fr_1fr]'>
      <article
        class='flex flex-col rounded-2xl border-2 border-ink bg-surface p-7 shadow-hard sm:p-9 md:row-span-2'
        data-reveal
      >
        <span class='sec-tag text-muted'>Who am I?</span>
        <p class='mt-5 text-2xl leading-snug sm:text-3xl'>
          A <b>true engineer</b>, not a “frameworker” — languages and frameworks are just tools for
          solving problems. I create <b>full-stack web applications</b>, mostly around the React
          ecosystem, with exposure to back-end stacks like ASP.NET and Express.js.
        </p>
        <div class='mt-7 flex flex-wrap gap-2'>
          {stack.map((tech) => <span class='chip'>{tech}</span>)}
        </div>
        <div class='mt-auto flex flex-wrap items-center gap-6 pt-9'>
          <a href='/about' class='btn btn-outline'>
            More about me
            <svg
              xmlns='http://www.w3.org/2000/svg'
              width='18'
              height='18'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2.5'
              stroke-linecap='round'
              stroke-linejoin='round'><path d='M5 12h14'></path><path d='m12 5 7 7-7 7'></path></svg
            >
          </a>
          <a
            href='/CV.pdf'
            download
            class='inline-flex items-center gap-1.5 font-bold underline-offset-4 transition hover:text-muted hover:underline'
          >
            <svg
              xmlns='http://www.w3.org/2000/svg'
              width='16'
              height='16'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2.5'
              stroke-linecap='round'
              stroke-linejoin='round'
              ><path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'></path><polyline
                points='7 10 12 15 17 10'></polyline><line x1='12' x2='12' y1='15' y2='3'
              ></line></svg
            >
            Download CV
          </a>
        </div>
      </article>

      <article
        class='rounded-2xl border-2 border-ink bg-accent p-7 text-black shadow-hard'
        data-reveal
      >
        <div class='text-5xl font-bold leading-none sm:text-6xl'>2–3 yrs</div>
        <p class='mt-3 font-bold opacity-80'>of hands-on experience building & shipping web applications</p>
      </article>

      <article
        class='flex items-center gap-5 rounded-2xl border-2 border-ink bg-surface p-6 shadow-hard'
        data-reveal
      >
        <div class='flex-none rounded-xl border-2 border-ink bg-white p-2'>
          <img src='/VT.png' alt='Vilnius Tech university logo' class='h-12 w-auto' loading='lazy' />
        </div>
        <div>
          <p class='font-bold'>BSc Software Engineering</p>
          <p class='mt-1 text-sm text-muted'>
            Scholarship for outstanding academic performance
          </p>
        </div>
      </article>
    </div>
  </div>
</section>
