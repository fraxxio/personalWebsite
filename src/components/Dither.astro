---
// Animated dithering panel (@paper-design/shaders). Animation pauses
// entirely for prefers-reduced-motion users.
interface Props {
  shape?: 'simplex' | 'warp' | 'dots' | 'wave' | 'ripple' | 'swirl' | 'sphere';
  front: string;
  back: string;
  pxSize?: number;
  speed?: number;
  class?: string;
}

const {
  shape = 'simplex',
  front,
  back,
  pxSize = 2.5,
  speed = 0.5,
  class: className,
} = Astro.props;
---

<div
  class:list={['dither-mount', className]}
  data-shape={shape}
  data-front={front}
  data-back={back}
  data-px-size={pxSize}
  data-speed={speed}
  aria-hidden='true'
>
</div>

<script>
  import {
    ShaderMount,
    ditheringFragmentShader,
    getShaderColorFromString,
    DitheringShapes,
    DitheringTypes,
  } from '@paper-design/shaders';

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.dither-mount').forEach((el) => {
    const d = el.dataset;
    new ShaderMount(
      el,
      ditheringFragmentShader,
      {
        u_colorFront: getShaderColorFromString(d.front),
        u_colorBack: getShaderColorFromString(d.back),
        u_shape: DitheringShapes[(d.shape ?? 'simplex') as keyof typeof DitheringShapes],
        u_type: DitheringTypes['4x4'],
        u_pxSize: Number(d.pxSize),
        u_fit: 0,
        u_scale: 1,
        u_rotation: 0,
        u_originX: 0.5,
        u_originY: 0.5,
        u_offsetX: 0,
        u_offsetY: 0,
        u_worldWidth: 0,
        u_worldHeight: 0,
      },
      undefined,
      prefersReduced ? 0 : Number(d.speed),
    );
  });
</script>
