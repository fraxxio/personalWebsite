---
/**
 * Renders an icon from the registry (src/icons/*.svg) by file name.
 * Registry convention: icons use stroke/fill="currentColor"; color is
 * set at the use site via text-* classes.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 16, ...rest } = Astro.props;

const icons = import.meta.glob<{ default: any }>("../../icons/*.svg", { eager: true });
const icon = icons[`../../icons/${name}.svg`];
if (!icon) {
  const available = Object.keys(icons)
    .map((path) => path.split("/").pop()!.replace(".svg", ""))
    .sort()
    .join(", ");
  throw new Error(`Unknown icon "${name}". Available icons: ${available}`);
}
const Svg = icon.default;
---

<Svg width={size} height={size} aria-hidden="true" {...rest} />
