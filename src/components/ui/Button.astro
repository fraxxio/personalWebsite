---
// Renders an <a> when href is given, a <button> otherwise.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'sm';
  class?: string;
  href?: string;
  target?: string;
  rel?: string;
  download?: boolean | string;
}

const { variant = 'primary', size = 'md', class: className, ...rest }: Props = Astro.props;
const Element = rest.href ? 'a' : 'button';

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-medium transition duration-200 ease-out cursor-pointer';
const sizes = {
  md: 'px-6 py-3 text-sm',
  sm: 'px-4 py-2 text-sm',
};
const variants = {
  primary:
    'glass-btn glass-btn-accent text-primary hover:-translate-y-0.5 active:translate-y-0',
  secondary: 'glass-btn border text-primary hover:border-strong',
  ghost: 'glass-btn-ghost text-secondary hover:text-primary',
};
---

<Element class:list={[base, sizes[size], variants[variant], className]} {...rest as any}>
  <slot />
</Element>
