---
interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'h4';
  size?: 'hero' | 'display' | 'section' | 'card';
  class?: string;
}

const { as: Tag = 'h2', size = 'section', class: className }: Props = Astro.props;

const sizes = {
  hero: 'text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl',
  display: 'text-4xl font-semibold tracking-tight sm:text-5xl',
  section: 'text-3xl font-semibold tracking-tight sm:text-4xl',
  card: 'text-xl font-medium tracking-tight',
};
---

<Tag class:list={['text-balance text-primary', sizes[size], className]}>
  <slot />
</Tag>
