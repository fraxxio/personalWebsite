---
// Layout width: 'wide' for page sections, 'narrow' for reading-width content.
interface Props {
  size?: 'wide' | 'narrow';
  class?: string;
}

const { size = 'wide', class: className } = Astro.props;
---

<div class="w-full px-6">
  <div
    class:list={[
      'mx-auto w-full',
      size === 'narrow' ? 'max-w-3xl' : 'max-w-7xl',
      className,
    ]}
  >
    <slot />
  </div>
</div>
