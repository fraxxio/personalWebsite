---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  total: number;
}

const { project, index, total } = Astro.props;
const { title, description, tags, thumbnail, website, github, featured } = project.data;
const counter = `${String(index + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
const href = `/projects/${project.id}`;
---

<article class='grid items-center gap-8 py-14 sm:py-20 md:grid-cols-2 md:gap-14' data-reveal>
  <div class:list={[index % 2 === 1 && 'md:order-2']}>
    <div class='flex items-center gap-3'>
      <span class='h-0.5 w-10 bg-ink'></span>
      <span class='sec-tag text-muted'>{counter}</span>
      {
        featured && (
          <span class='inline-flex items-center rounded-full border-2 border-black bg-accent px-3 py-1.5 text-xs font-bold text-black'>
            ★ Featured
          </span>
        )
      }
    </div>
    <h3 class='mt-4 text-4xl font-bold sm:text-5xl'>
      <a href={href} class='underline-offset-8 transition hover:underline'>{title}</a>
    </h3>
    <div class='mt-5 flex flex-wrap gap-2'>
      {tags.map((tag: string) => <span class='chip'>{tag}</span>)}
    </div>
    <p class='mt-5 max-w-md text-lg text-muted'>{description}</p>
    <div class='mt-8 flex flex-wrap items-center gap-x-6 gap-y-4'>
      <a href={href} class='btn btn-solid'>
        Case study
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='18'
          height='18'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'><path d='M5 12h14'></path><path d='m12 5 7 7-7 7'></path></svg
        >
      </a>
      {
        website && (
          <a
            href={website}
            target='_blank'
            rel='noopener noreferrer'
            class='font-bold underline-offset-4 transition hover:text-muted hover:underline'
          >
            Live demo ↗
          </a>
        )
      }
      <a
        href={github}
        target='_blank'
        rel='noopener noreferrer'
        class='font-bold underline-offset-4 transition hover:text-muted hover:underline'
      >
        Source ↗
      </a>
    </div>
  </div>
  <a
    href={href}
    tabindex='-1'
    aria-hidden='true'
    class='group block overflow-hidden rounded-2xl border-2 border-ink bg-surface shadow-hard-lg'
  >
    <Image
      src={thumbnail}
      alt=''
      width={1100}
      class='w-full object-cover transition duration-500 group-hover:scale-[1.03]'
    />
  </a>
</article>
