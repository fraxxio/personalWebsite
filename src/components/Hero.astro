---
import Dither from './Dither.astro';
---

<header id='home' class='px-4 pb-16 pt-36 sm:pt-44'>
  <div class='mx-auto flex max-w-6xl flex-col items-center text-center'>
    <p class='sec-tag fade-up text-muted' style='--d: 0ms'>
      <span id='hand' class='inline-block'>👋🏼</span>&ensp;Hi, my name is Rokas
    </p>
    <h1
      class='fade-up mt-5 max-w-4xl text-4xl font-bold leading-[1.05] sm:text-6xl lg:text-7xl'
      style='--d: 120ms'
    >
      Self-taught full-stack developer building real, shipped web&nbsp;apps
    </h1>
    <div class='fade-up mt-9 flex flex-wrap justify-center gap-4' style='--d: 240ms'>
      <a href='/#projects' class='btn btn-solid'>
        View projects
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='18'
          height='18'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'><path d='M5 12h14'></path><path d='m12 5 7 7-7 7'></path></svg
        >
      </a>
      <a href='/CV.pdf' download class='btn btn-outline'>
        Download CV
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='18'
          height='18'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          ><path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'></path><polyline
            points='7 10 12 15 17 10'></polyline><line x1='12' x2='12' y1='15' y2='3'></line></svg
        >
      </a>
    </div>
    <div
      class='fade-up relative mt-16 h-[45vh] min-h-[300px] w-full overflow-hidden rounded-2xl border-2 border-ink shadow-hard-lg'
      style='--d: 360ms'
    >
      <Dither
        class='absolute inset-0'
        shape='wave'
        front='#161613'
        back='#f2f0e9'
        darkFront='#f5c518'
        darkBack='#141414'
        speed={0.35}
        pxSize={2.5}
      />
      <span class='chip absolute bottom-4 left-4'>✦ Full-stack web apps</span>
      <span class='chip absolute bottom-4 right-4 max-sm:hidden'>React · Next · TypeScript</span>
    </div>
  </div>
</header>

<script>
  // Little wave on click, as a nod to the old site.
  const hand = document.getElementById('hand');
  hand?.addEventListener('click', () => {
    hand.classList.remove('animate-waving');
    requestAnimationFrame(() => hand.classList.add('animate-waving'));
  });
</script>

<style>
  .fade-up {
    opacity: 0;
    animation: fade-up 700ms ease-out forwards;
    animation-delay: var(--d, 0ms);
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  #hand {
    cursor: pointer;
  }
  .animate-waving {
    animation: wave 1s ease-in-out;
  }
  @keyframes wave {
    0%, 100% { transform: rotate(0deg); }
    15% { transform: rotate(16deg); }
    30% { transform: rotate(-8deg); }
    45% { transform: rotate(16deg); }
    60% { transform: rotate(-4deg); }
    75% { transform: rotate(10deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fade-up,
    .animate-waving {
      animation: none;
      opacity: 1;
    }
  }
</style>
