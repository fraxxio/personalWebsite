---
import { Image } from "astro:assets";
import GrainGradient from "./GrainGradient.astro";
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import Text from "./ui/Text.astro";
import heroIllustration from "../assets/HeroIllustration.png";
---

<header id="home" class="relative overflow-hidden px-6 pb-20 pt-36 sm:pt-44">
  <div
    class="pointer-events-none absolute inset-0  mask-[linear-gradient(to_bottom,black_60%,transparent)]"
    aria-hidden="true"
  >
    <GrainGradient
      class="absolute inset-0"
      shape="corners"
      colors={["#6026a6", "#10ad9a", "#00e1ff"]}
      colorBack="#0a1412"
      speed={1}
      softness={1}
      noise={0.2}
    />
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-128 bg-[radial-gradient(60%_50%_at_50%_0%,rgba(45,212,191,0.06),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto flex max-w-7xl flex-col items-center text-center">
    <Text as="span" variant="label" tone="muted" class="fade-up w-full text-left" style="--d: 0ms">
      Hi, my name is Rokas
    </Text>
    <h1
      class="fade-up mt-6 text-balance text-5xl font-semibold leading-[1.05] tracking-tight text-primary sm:text-6xl lg:text-7xl text-left"
      style="--d: 120ms"
    >
      Front-end engineer building large-scale, high-performance web&nbsp;apps
    </h1>
    <div class="fade-up mt-10 flex flex-wrap gap-4 w-full" style="--d: 240ms">
      <Button href="/#projects">
        View projects
        <Icon name="arrow-right" />
      </Button>
      <Button href="/CV.pdf" download variant="secondary">
        Download CV
        <Icon name="download" />
      </Button>
    </div>
    <div
      class="fade-up relative mt-20 h-[45vh] min-h-75 w-full overflow-hidden rounded-card border shadow-elevated"
      style="--d: 360ms"
    >
      <Image
        class="absolute inset-0 h-full w-full object-cover"
        src={heroIllustration}
        alt=""
        widths={[540, 720, 900, 1080]}
        sizes="(min-width: 1280px) 1232px, 100vw"
        loading="eager"
        aria-hidden="true"
      />
      <div
        class="pointer-events-none absolute inset-0 bg-linear-to-t from-background/60 via-transparent to-background/20"
        aria-hidden="true"
      >
      </div>
      <Badge class="absolute bottom-5 left-5 backdrop-blur-sm">Front-end at scale</Badge>
      <Badge class="absolute bottom-5 right-5 backdrop-blur-sm max-sm:hidden">
        React · Next · TypeScript
      </Badge>
    </div>
  </div>
</header>

<style>
  .fade-up {
    opacity: 0;
    animation: fade-up 600ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d, 0ms);
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fade-up {
      animation: none;
      opacity: 1;
    }
  }
</style>
