---
import ProjectCard from './ProjectCard.astro';
import Container from './ui/Container.astro';
import Divider from './ui/Divider.astro';
import Heading from './ui/Heading.astro';
import Section from './ui/Section.astro';
import Text from './ui/Text.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);
---

<Section id='projects'>
  <Container>
    <div class='max-w-3xl' data-reveal>
      <Text as='span' variant='label' tone='muted'>Selected work</Text>
      <Heading as='h2' class='mt-4'>Projects</Heading>
      <Text variant='lead' class='mt-4'>
        Real applications, designed, built and shipped end to end.
      </Text>
    </div>

    <div class='mt-8'>
      {
        projects.map((project, index) => (
          <>
            {index > 0 && <Divider />}
            <ProjectCard project={project} index={index} total={projects.length} />
          </>
        ))
      }
    </div>
  </Container>
</Section>
